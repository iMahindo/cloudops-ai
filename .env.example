APP_NAME=CloudOps AI
SERVICE_NAME=cloudops-ai
APP_DESCRIPTION=AI-powered knowledge assistant for Cloud Operations.
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

METRICS_ENABLED=true

#tracing endpoint
OTLP_TRACES_ENDPOINT="http://tempo:4318/v1/traces"

#GROQ API
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1024

#DOCUMENT PROCESSING
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

#QDRANT API
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=cloudops_knowledge
QDRANT_HTTPS=false
# QDRANT_API_KEY=replace-with-your-qdrant-api-key
QDRANT_CREATE_COLLECTION_ON_STARTUP=true

#GEMINI API
GEMINI_API_KEY=ci-placeholder-not-a-real-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

#RAG CONFIG
RAG_RETRIEVAL_LIMIT=5

#NOTION
#NOTION_API_KEY=replace-with-your-notion-api-key
INGESTION_ENABLED=true